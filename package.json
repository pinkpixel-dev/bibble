{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@pinkpixel/bibble",
  "version": "1.9.0",
  "description": "An AI agent/chatbot with built-in tools and MCP support that lives in your terminal",
  "license": "Apache 2.0",
  "author": "Pink Pixel",
  "homepage": "https://npmjs.com/package/@pinkpixel/bibble",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
    "bin": {
    "bibble": "bin/bibble-cli.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pinkpixel-dev/bibble",
    "issues": "https://github.com/pinkpixel-dev/bibble/issues",
    "organization": "pinkpixel-dev",
    "owner": "sizzlebop"
  },
    "contributors": [
    "Jessica Doering <admin@pinkpixel.dev>"
  ],
  "maintainers": [
    "sizzlebop <admin@pinkpixel.dev>"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --external commander,chalk,inquirer,markdown-it,openai,boxen,uuid,child_process,cross-spawn,@anthropic-ai/sdk,isbinaryfile,zod,zod-to-json-schema,cli-spinners",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "lint": "eslint . --ext .ts --fix",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "postinstall": "node -e \"try { require('fs').chmodSync('./bin/bibble.js', '755'); require('fs').chmodSync('./bin/bibble-cli.js', '755'); require('fs').chmodSync('./bin/bibble-cli.cjs', '755'); } catch (e) { console.error(e) }\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typecheck": "tsc --noEmit",
    "release": "npm run build && npm run lint && npm run typecheck && npm run test && npm run prepare && npm run postinstall && npm publish --access public",
    "prettier": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.61.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.18.1",
    "@mozilla/readability": "^0.6.0",
    "@pinkpixel/pixelpop": "^1.0.1",
    "ascii-text-generator": "^1.0.5",
    "axios": "^1.12.2",
    "boxen": "^8.0.1",
    "boxen-cli": "^4.0.0",
    "chalk": "^5.6.2",
    "chalk-animation": "^2.0.3",
    "cheerio": "^1.1.2",
    "cli-highlight": "^2.1.11",
    "cli-progress": "^3.12.0",
    "cli-spinners": "^3.2.1",
    "cli-truncate": "^5.1.0",
    "clipboardy": "^4.0.0",
    "commander": "^14.0.1",
    "figlet": "^1.9.3",
    "figures": "^6.1.0",
    "gradient-string": "^3.0.0",
    "inquirer": "^12.9.6",
    "isbinaryfile": "^5.0.6",
    "jsdom": "^27.0.0",
    "json-stringify-pretty-compact": "^4.0.0",
    "log-symbols": "^7.0.1",
    "markdown-it": "^14.1.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "meow": "^14.0.0",
    "node-fetch": "^3.3.2",
    "openai": "^5.22.0",
    "p-limit": "^7.1.1",
    "string-width": "^8.1.0",
    "strip-ansi": "^7.1.2",
    "supports-color": "^10.2.2",
    "supports-hyperlinks": "^4.2.0",
    "terminal-link": "^5.0.0",
    "typescript": "^5.9.2",
    "uuid": "^13.0.0",
    "wrap-ansi": "^9.0.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "tsup": "^8.5.0",
    "typescript-eslint": "^8.44.0"
  },
    "keywords": [
    "ai",
    "ai-agent",
    "agent",
    "agent-cli",
    "anthropic",
    "assistant",
    "chat",
    "chatbot",
    "chatbot",
    "claude",
    "cli",
    "command-line",
    "command-line-interface",
    "code",
    "code-assistant",
    "code-generation",
    "code-review",
    "coding",
    "context",
    "developer-assistant",
    "developer",
    "google",
    "gpt",
    "image-rendering",
    "javascript",
    "llm",
    "llm-agent",
    "mcp",
    "mcp-agent",
    "modelcontextprotocol",
    "openai",
    "openai-api",
    "productivity",
    "productivity-tool",
    "productivity-assistant",
    "terminal",
    "terminal-assistant",
    "terminal-chatbot",
    "tools",
    "tool-using-agent",
    "typescript",
    "typescript-cli",
    "zod"
  ]
}
